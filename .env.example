# ============================================================
# Freshoo Frontend / Full-Stack Environment Variables Template
# Copy this file to .env.local for local development.
# For Vercel, set these variables in: Project Settings -> Environment Variables
# ============================================================

# MongoDB Connection String (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/freshoo?retryWrites=true&w=majority
MONGODB_DB_NAME=freshoo

# JWT / Authentication Secrets (Generate secure 32+ character strings)
JWT_SECRET=your-32-char-random-jwt-secret-string-here
JWT_EXPIRES_IN=30d
AUTH_COOKIE_NAME=freshoo_auth
AUTH_COOKIE_DOMAIN=

# Application URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_SITE_NAME=Freshoo

# Optional: External Backend URL (Leave empty or unset if using Next.js built-in API routes)
# In development with separate Express backend, set to: http://localhost:4000/api/v1
NEXT_PUBLIC_BACKEND_URL=

# Store / Admin Configuration (Receives New Order Email Notifications)
ADMIN_EMAIL=freshoo.online@gmail.com
ADMIN_PHONE=+919310593167
STORE_OWNER_EMAIL=freshoo.online@gmail.com
STORE_OWNER_NAME="Freshoo Store Admin"

# Brevo (Sendinblue) Email Notifications
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=freshoo.online@gmail.com
BREVO_SENDER_NAME=freshoo
BREVO_ORDER_NOTIFY_ENABLED=true
BREVO_NEW_ORDER_TEMPLATE_ID=
BREVO_WELCOME_TEMPLATE_ID=
BREVO_CUSTOMER_ORDER_CONFIRM_TEMPLATE_ID=

